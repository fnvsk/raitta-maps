{
  "name": "raita",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAITA - real-time public transport tracking for Tampere. Move with the city.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc --noEmit && vite build && node scripts/build-site.mjs",
    "native": "tsc --noEmit && vite build --mode native && cap sync android",
    "android": "npm run native && node scripts/build-android.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "data": "node scripts/build-data.mjs && node scripts/build-fuel.mjs",
    "icons": "node scripts/build-icons.mjs",
    "bot": "node scripts/setup-telegram-bot.mjs",
    "telegram": "node scripts/setup-telegram.mjs",
    "maps": "tsc --noEmit && node scripts/build-maps.mjs",
    "android:bundle": "node scripts/build-play.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "i18next": "^26.6.0",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "^6.16.0",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.10",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
