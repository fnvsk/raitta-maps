limit_req_zone $binary_remote_addr zone=raitta_route:10m rate=30r/s;

proxy_cache_path /var/cache/raitta-flights levels=1 keys_zone=raitta_flights:1m max_size=50m inactive=24h use_temp_path=off;
map $upstream_http_content_length $raitta_flights_empty {
    "0" 1;
    default 0;
}
map $upstream_http_content_length $raitta_flights_cache_control {
    "0" "no-store";
    default "public, max-age=60";
}

map $http_origin $raitta_route_cors {
    default "";
    ~^https://((www|maps)\.)?raitta\.fi$ $http_origin;
    ~^https://raita-xi\.vercel\.app$ $http_origin;
    ~^https://localhost$ $http_origin;
    ~^capacitor://localhost$ $http_origin;
    ~^http://localhost(:[0-9]+)?$ $http_origin;
}

server {
    listen 80;
    listen [::]:80;
    server_name route.raitta.fi;

    location /.well-known/acme-challenge/ {
        root /var/www/raitta-acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

